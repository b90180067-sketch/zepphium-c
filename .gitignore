# ---- Build outputs ----
build/
*.o
*.exe
*.dll
# Binaries (zephium_gcc.exe, zephium_clang.exe, windows/zephium_win.exe,
# windows/WebView2Loader.dll) are published as GitHub Releases - never committed.
# See "Binaries" in README.md.
*.d
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile.cmake

# ---- Runtime data ----
# Browser profile: contains personal browsing history, never commit it
*.db
*.db-wal
*.db-shm
*.log

# ---- Python ----
__pycache__/
*.pyc

# ---- Windows shell (Win32 + WebView2) ----
windows/sdk/
windows/obj/
windows/*.o
windows/*.exe
windows/*.dll
windows/*.log
windows/*.png
windows/WebView2*.zip
windows/zephium_webview2_profile/
windows/*.WebView2/
# Start page assets are copied from ../newtab by "mingw32-make assets".
windows/newtab/

# ---- Native ad blocking (Windows) ----
# Downloaded filter lists, the binary engine cache and the adblock log are
# runtime data, never committed. The Rust engine source is in blocker/rust; only
# its build output is ignored.
blocker/rust/target/
windows/zephium_adblock/

# ---- WSL/Linux out-of-tree build trees ----
build-wsl/
build-*/

# ---- Local scratch ----
.tmp_*
.git-msg.txt
Makefile.local

# ---- Local verification artifacts ----
yt_playback_verified.png
_bench*
perf_*
